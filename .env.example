# ==============================================================================
# Code Saaya (repo-saaya) - Environment Variables Configuration
# ==============================================================================

# ─── 1. Application URL ────────────────────────────────────────────────────────
# Base URL for the app (used for OAuth callbacks and Referer headers)
# Locally: http://localhost:3000 | Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── 2. Clerk Authentication (Required) ────────────────────────────────────────
# Required for session management, route protection, and user context.
# Sign up at https://clerk.com and obtain keys from your dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── 3. Appwrite Backend (Required) ───────────────────────────────────────────
# Used for job state persistence, real-time logging, user settings, and artifacts.
# Obtain from your Appwrite Cloud or self-hosted project console.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_admin_api_key
APPWRITE_DATABASE_ID=saaya_db
NEXT_PUBLIC_APPWRITE_DATABASE_ID=saaya_db

# ─── 4. GitHub Integration (Required for Documentation & PR Delivery) ─────────
# GitHub Personal Access Token (classic ghp_... with `repo` scope, or fine-grained
# token with `Contents` and `Pull requests` read & write permissions).
# Required to fetch file trees, sample code, and commit/open pull requests.
GITHUB_TOKEN=ghp_...

# ─── 5. AI / OpenRouter (Optional / Platform Fallback) ────────────────────────
# Optional fallback key if users do not supply their own in Dashboard Settings.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_AUTH_URL=https://openrouter.ai/auth
OPENROUTER_API_URL=https://openrouter.ai/api/v1
